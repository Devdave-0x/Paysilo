# RPC endpoint for Ethereum Sepolia (Alchemy, Infura, or any provider)
SEPOLIA_RPC_URL=

# Deployer / payroll admin private key (use a burner, never your main wallet)
DEPLOYER_PRIVATE_KEY=

# Set after deployMockUSDC.ts, or point at an existing Sepolia test token
UNDERLYING_TOKEN=

# The Safe address (or admin EOA for early testing) authorized to run payroll batches
PAYROLL_ADMIN=

# Set after deploy.ts
PAYSILO_ADDRESS=

# For scripts/grantAuditorAccess.ts
AUDITOR_ADDRESS=

# For contract verification
ETHERSCAN_API_KEY=

# The Safe treasury address (payrollAdmin). Create at https://app.safe.global on Sepolia.
SAFE_ADDRESS=

# For scripts/decryptBalance.ts: whose balance to decrypt (defaults to signer)
TARGET_ACCOUNT=
