{
  "name": "paysilo-contracts",
  "version": "0.1.0",
  "description": "Confidential payroll layer for Safe treasuries, built on iExec Nox for the WTF!! Hackathon Summer Edition",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "payroll:sepolia": "hardhat run scripts/runPayroll.ts --network sepolia",
    "grant:sepolia": "hardhat run scripts/grantAuditorAccess.ts --network sepolia",
    "deploy:mock": "hardhat run scripts/deployMockUSDC.ts --network sepolia",
    "payroll:safe": "hardhat run scripts/runPayrollViaSafe.ts --network sepolia",
    "decrypt:sepolia": "hardhat run scripts/decryptBalance.ts --network sepolia",
    "check:sepolia": "hardhat run scripts/checkSetup.ts --network sepolia",
    "demo:sepolia": "hardhat run scripts/demoFlow.ts --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@iexec-nox/nox-hardhat-plugin": "^0.1.0",
    "hardhat": "^3.0.0",
    "typescript": "^5.6.0",
    "dotenv": "^16.4.5"
  },
  "dependencies": {
    "@iexec-nox/handle": "^0.1.0-beta.13",
    "@iexec-nox/nox-confidential-contracts": "^0.2.2",
    "@iexec-nox/nox-protocol-contracts": "^0.2.4",
    "@openzeppelin/contracts": "^5.6.1",
    "viem": "^2.21.0",
    "@safe-global/protocol-kit": "^8.0.4"
  }
}